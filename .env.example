# Caller authentication. Chat and usage routes reject requests without this key.
GATEWAY_KEY_ID=local
GATEWAY_API_KEY=local-dev-key-change-me
GATEWAY_RPM=60

# Optional. When set, replaces the single key above.
# Format: id|secret|requestsPerMinute,id|secret|requestsPerMinute
# GATEWAY_API_KEYS=local|local-dev-key-change-me|60,batch|another-long-secret|10

# Upstream OpenAI-compatible API. Blank is allowed: the process still boots,
# and chat completions fail with 503 until a key is present.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT=60s

PORT=8080
